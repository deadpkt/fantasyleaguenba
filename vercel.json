{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/data.py": {
      "maxDuration": 60
    },
    "api/logo.py": {
      "maxDuration": 15
    },
    "api/news.py": {
      "maxDuration": 60
    },
    "api/live.py": {
      "maxDuration": 30
    },
    "api/announcements.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}